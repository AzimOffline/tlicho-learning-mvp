{
  "name": "tlicho-learning-mvp",
  "version": "1.0.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "mobile:build": "node scripts/build-mobile-web.mjs",
    "mobile:sync": "capacitor sync android",
    "android:apk": "node scripts/build-android-apk.mjs",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import ./scripts/tsx-userinfo-workaround.mjs --import tsx --test tests/*.test.ts",
    "format": "prettier --check --ignore-path .gitignore .",
    "format:fix": "prettier --write --ignore-path .gitignore .",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:prod": "tsx ./scripts/prod.ts",
    "db:seed:tlicho": "tsx ./scripts/seed-tlicho.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@clerk/nextjs": "^7.8.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.41.0",
    "next": "^16.3.5",
    "ra-data-simple-rest": "^5.15.3",
    "react": "^19.3.0",
    "react-admin": "^5.15.3",
    "react-circular-progressbar": "^2.2.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.8",
    "react-use": "^17.6.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.7",
    "@vercel/config": "^0.7.1",
    "autoprefixer": "^10.5.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.23.0",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^6",
    "wrangler": "4.135.0"
  },
  "packageManager": "pnpm@11.11.0",
  "description": "A Duolingo-style Tłı̨chǫ language-learning prototype.",
  "keywords": [
    "Tłı̨chǫ",
    "language-learning",
    "FSRS",
    "Next.js"
  ],
  "license": "MIT"
}
